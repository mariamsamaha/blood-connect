SUPABASE_HOST=db.YOUR_PROJECT.supabase.co
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres
SUPABASE_DB_PASSWORD=your-supabase-db-password
SUPABASE_REQUIRE_SSL=true
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/keys/firebase-adminsdk.json
NOTIFICATION_BACKEND_SECRET=change-me-to-a-long-random-string
INTERNAL_SECRET=change-me-to-a-long-random-string
REDIS_URL=redis://redis:6379
TOKEN_CACHE_TTL_SEC=1800
LOG_LEVEL=info
