# Copy this file to `.env` in the project root (gitignored).
# Everyone on the team can use their own `.env` — do not commit `.env`.
#
# ── Android emulator (default if .env is missing) ─────────────────────────────
# API_BASE_URL=http://10.0.2.2:8090
#
# ── iOS simulator (default if .env is missing) ────────────────────────────────
# API_BASE_URL=http://127.0.0.1:8090
#
# ── Physical phone / tablet (same Wi‑Fi as your PC) ─────────────────────────────
# 1. On your PC: ipconfig  (Windows) or ifconfig  (Mac/Linux) → note IPv4, e.g. 192.168.1.42
# 2. Start API: cd api-backend && npm start  (listens on all interfaces)
# 3. Uncomment and set:
# API_BASE_URL=http://192.168.1.42:8090
#
# ── Optional ──────────────────────────────────────────────────────────────────
# AI_SERVICE_URL=http://10.0.2.2:8000
# NOTIFICATION_BACKEND_URL=http://10.0.2.2:8080
# NOTIFICATION_BACKEND_SECRET=
# Load test / ZAP bypass — NEVER set to true in production

# ── Metrics auth (optional) ────────────────────────────────────────────────────
# Set a strong random string to require Bearer token auth on /metrics and /slo.
# Prometheus must be configured with: bearer_token: <same value>
# Leave empty to allow access from private IPs only (default for Docker deployments).
# Generate: openssl rand -hex 32
# METRICS_TOKEN=