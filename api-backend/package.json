{
  "name": "bloodconnect-api",
  "version": "1.0.0",
  "private": true,
  "description": "BloodConnect BFF — Firebase-authenticated REST API over Postgres",
  "main": "src/cluster.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:e2e": "jest --forceExit --detectOpenHandles --testPathPattern='tests/e2e/'"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/tests/e2e/"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 20,
        "functions": 20,
        "lines": 30,
        "statements": 30
      },
      "./src/circuit-breaker.js": {
        "branches": 50,
        "functions": 80,
        "lines": 65,
        "statements": 65
      },
      "./src/errors.js": {
        "branches": 60,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./src/db.js": {
        "branches": 80,
        "functions": 40,
        "lines": 50,
        "statements": 50
      },
      "./src/metrics.js": {
        "branches": 70,
        "functions": 80,
        "lines": 90,
        "statements": 90
      },
      "./src/logger.js": {
        "branches": 45,
        "functions": 0,
        "lines": 65,
        "statements": 65
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
