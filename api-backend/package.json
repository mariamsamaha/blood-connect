{
  "name": "bloodconnect-api",
  "version": "1.0.0",
  "private": true,
  "description": "BloodConnect BFF — Firebase-authenticated REST API over Postgres",
  "main": "src/cluster.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:e2e": "jest --forceExit --detectOpenHandles --config jest.e2e.config.js",
    "test:integration": "jest --forceExit --detectOpenHandles --config jest.integration.config.js",
    "lint": "eslint src/ --ext .js --max-warnings 0",
    "lint:fix": "eslint src/ --ext .js --fix",
    "lint:report": "eslint src/ --ext .js --format json --output-file coverage/eslint-report.json",
    "lint:security": "eslint src/ --ext .js --rule \"security/detect-non-literal-regexp: error\" --rule \"security/detect-eval-with-expression: error\" --rule \"security/detect-child-process: error\""
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/tests/e2e/"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 18,
        "functions": 15,
        "lines": 28,
        "statements": 28
      },
      "./src/circuit-breaker.js": {
        "branches": 75,
        "functions": 90,
        "lines": 85,
        "statements": 85
      },
      "./src/errors.js": {
        "branches": 60,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/auth.js": {
        "branches": 25,
        "functions": 15,
        "lines": 20,
        "statements": 25
      },
      "./src/db.js": {
        "branches": 80,
        "functions": 50,
        "lines": 60,
        "statements": 60
      },
      "./src/metrics.js": {
        "branches": 25,
        "functions": 40,
        "lines": 70,
        "statements": 65
      },
      "./src/logger.js": {
        "branches": 45,
        "functions": 0,
        "lines": 65,
        "statements": 65
      },
      "./src/redis.js": {
        "branches": 55,
        "functions": 55,
        "lines": 60,
        "statements": 60
      },
      "./src/slo.js": {
        "branches": 50,
        "functions": 60,
        "lines": 60,
        "statements": 60
      },
      "./src/trace.js": {
        "branches": 80,
        "functions": 90,
        "lines": 85,
        "statements": 85
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
