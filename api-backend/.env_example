# Copy this file to .env and fill in your values.
# DO NOT commit .env to the repository.
PORT=8090
NODE_ENV=development

# Supabase Postgres (pooler recommended, SSL on)
# Get these from your Supabase project dashboard → Settings → Database
SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_PORT=6543
SUPABASE_DATABASE=postgres
SUPABASE_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-password>

# Firebase Admin - download JSON from Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=<your-firebase-project-id>
GOOGLE_APPLICATION_CREDENTIALS=../keys/<firebase-adminsdk-file>.json

# Internal services
NOTIFICATION_BACKEND_URL=http://localhost:8080
NOTIFICATION_BACKEND_SECRET=<shared-secret>
AI_SERVICE_URL=http://localhost:8000
AI_ASSISTANT_API_KEY=<openrouter-api-key>

# Low inventory check interval (ms)
LOW_INVENTORY_CHECK_INTERVAL=300000ms
